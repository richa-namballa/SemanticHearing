{
    "model": "src.training.dcc_tf_binaural",
    "base_metric": "scale_invariant_signal_noise_ratio",
    "fix_lr_epochs": 40,
    "epochs": 80,
    "batch_size": 8,
    "eval_batch_size": 16,
    "n_workers": 4,
    "model_params": {
        "L": 32,
        "label_len": 4,
        "model_dim": 256,
        "num_enc_layers": 10,
        "num_dec_layers": 1,
        "dec_buf_len": 13,
        "dec_chunk_size": 13,
        "use_pos_enc": true,
        "conditioning": "mult",
        "out_buf_len": 4
    },
    "train_dataset": "src.training.datasets.musdb_binaural.MUSDBDataset",
    "train_data_args": {
        "root": "/scratch/rn2214/source-separation/data/binaural_musdb18/split/",
        "subset": "train",
        "sample_rate": 44100
    },
    "val_dataset": "src.training.datasets.musdb_binaural.MUSDBDataset",
    "val_data_args": {
        "root": "/scratch/rn2214/source-separation/data/binaural_musdb18/split/",
        "subset": "valid",
        "sample_rate": 44100
    },
    "test_dataset": "src.training.datasets.musdb_binaural.MUSDBDataset",
    "test_data_args": {
        "root": "/scratch/rn2214/source-separation/data/binaural_musdb18/split/",
        "subset": "test",
        "sample_rate": 44100
    },
    "optim": {
        "lr": 0.0005,
        "weight_decay": 0.0
    },
    "lr_sched": {
        "mode": "max",
        "factor": 0.5,
        "patience": 5,
        "min_lr": 5e-06,
        "threshold": 0.1,
        "threshold_mode": "abs"
    }
}
